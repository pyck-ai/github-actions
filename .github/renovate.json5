{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Renovate's recommended defaults: grouping, ignore patterns, etc.
    "config:recommended",
    // Track everything on the Dependency Dashboard issue, including pending updates.
    ":dependencyDashboard",
    // Shared org defaults (branchPrefix, timezone, automerge schedule/strategy,
    // minimumReleaseAge, labels, semanticCommits, vulnerability alerts).
    "local>pyck-ai/renovate//presets/default.json5",
  ],
  // Two surfaces to keep current: the npm dependencies behind the TypeScript tooling,
  // and the SHA-pinned actions in .github/workflows/ plus the two composite actions
  // (ghcr-tidy/action.yml, verify-image/action.yml).
  enabledManagers: ["npm", "github-actions"],
  // Pin the Node that the runner installs for npm work to the same major ci.yml uses
  // (`node-version: 22`), not merely to package.json's ">=22" floor. The post-upgrade
  // hook rebuilds a COMMITTED artifact, so it has to produce byte-identical output to
  // the CI job that checks it.
  constraints: {
    node: "^22.0.0",
  },
  // The shared preset's packageRules (automerge by update type, major-update review,
  // digest/pin release-age handling) arrive first via extends and are prepended ahead
  // of these, so later-rules-win still holds for the repo-specific rules below.
  packageRules: [
    {
      // Grouped per manager rather than one batch for everything. An npm update drags
      // the rebuilt ncc bundle along with it (see the postUpgradeTasks rule below),
      // and folding action pin bumps into that same PR would put unrelated changes
      // behind a bundle rebuild.
      description: "Group npm minor and patch updates into one PR",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "npm minor and patch",
    },
    {
      description: "Group GitHub Actions pin updates into one PR",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin"],
      groupName: "github actions",
    },
    {
      // THE load-bearing rule for this repo. ghcr-tidy/dist/ is a committed ncc bundle
      // with the runtime dependencies inlined into it, and ci.yml's `build` job reruns
      // `npm run bundle` and fails on any diff, tracked or untracked. So an @octokit/*
      // or yaml bump that lands without rebuilding the bundle fails its OWN pull
      // request, every single time.
      //
      // Runs for every npm update rather than only the bundled runtime deps: the hook
      // is idempotent, a devDependency bump simply produces no diff, and enumerating
      // which packages reach the bundle would be a second source of truth that rots
      // silently as packages move between dependencies and devDependencies.
      //
      // fileFilters is scoped to the bundle because it is the only tracked path the
      // hook can change: tsc output goes to the gitignored lib/, and npm ci touches
      // only node_modules. Renovate folds package.json and package-lock.json in itself.
      description: "Rebuild the committed ncc bundle after npm updates",
      matchManagers: ["npm"],
      postUpgradeTasks: {
        commands: ["./.github/renovate-post-upgrade.sh"],
        fileFilters: ["ghcr-tidy/dist/**"],
        executionMode: "branch",
        // Renovate provisions the toolchain; the hook never installs anything
        // itself. This makes Renovate prepend a containerbase install for node,
        // at the version resolved from `constraints.node` above, before running
        // the command. So the script can simply assume npm exists, and the Node
        // major stays declared once, next to the constraint ci.yml shares.
        installTools: { node: true },
      },
    },
  ],
}
