{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": ".",
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "ghcr-tidy/src/**/*.ts",
    "branch-tidy/src/**/*.ts",
    "run-tidy/src/**/*.ts",
    "cache-tidy/src/**/*.ts",
    "registry/**/*.ts",
    "tidy-core/**/*.ts"
  ],
  "exclude": [
    "lib",
    "node_modules",
    "ghcr-tidy/dist",
    "branch-tidy/dist",
    "run-tidy/dist",
    "cache-tidy/dist",
    "**/*.test.ts"
  ]
}
