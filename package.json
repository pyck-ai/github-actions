{
  "name": "@pyck-ai/github-actions",
  "version": "0.1.0",
  "description": "Shared TypeScript registry core and CLI tools (imgverify, ghcr-tidy, ghcr-audit) for pyck-ai GHCR maintenance.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "npm run bundle:ghcr-tidy && npm run bundle:prune",
    "bundle:ghcr-tidy": "ncc build src/ghcr-tidy/cli.ts -o .github/actions/ghcr-tidy/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle:prune": "find .github/actions/ghcr-tidy/dist \\( -name '*.d.ts' -o -name '*.d.ts.map' \\) -delete"
  },
  "dependencies": {
    "@octokit/core": "^6.1.2",
    "@octokit/plugin-paginate-rest": "^11.3.6",
    "@octokit/plugin-retry": "^7.1.2",
    "@octokit/plugin-throttling": "^9.3.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
